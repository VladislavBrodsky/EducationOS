# Synthetic local development only; root .env is for Next, not backend settings.
NEXT_TELEMETRY_DISABLED=1
# Read at Next dev startup / production BUILD time. Server-only.
PYTHON_API_URL=http://127.0.0.1:8000
# Default: serve the portal on exact app.educationos.space; /portal previews it locally.
# For separate services, use "public" on marketing and "portal" on the learner portal.
# Public mode redirects /portal URLs to the app origin; portal mode includes preview domains.
EDUCATIONOS_SURFACE=auto
# Set to production only for an approved public marketing deployment. Portal stays noindex.
DEPLOYMENT_ENV=development
# Backend settings are in backend/.env.example; export them explicitly.
