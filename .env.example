# Demo starts without a database. Never put real child data into this release.
NEXT_TELEMETRY_DISABLED=1
APP_ORIGIN=http://127.0.0.1:3000
DEPLOYMENT_ENV=development
# development | staging | production. Production canonical is https://educationos.space.
AUTH_MODE=disabled
# PostgreSQL examples ONLY. Local Docker credentials are disposable.
# DATABASE_URL=postgresql://educationos:educationos_local@localhost:5432/educationos?sslmode=disable
# DIRECT_URL=postgresql://educationos:educationos_local@localhost:5432/educationos?sslmode=disable
# Hosted connections MUST use sslmode=verify-full or verify-ca; prefer verify-full.
# Keep pooled runtime DATABASE_URL and direct migration DIRECT_URL in hosting secret storage.
# Reserved for a future reviewed consent verification provider, not a consent bypass:
# CONSENT_VERIFICATION_PROVIDER=
# Optional disposable TCP database for integration tests (must name educationos_test):
# TEST_DATABASE_URL=postgresql://educationos:educationos_local@127.0.0.1:5432/educationos_test?sslmode=disable
