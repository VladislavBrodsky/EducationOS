# Adult workspace supports attested local/staging testers; identity is unverified.
# Production adult access, child profiles and learner AI remain closed.
# Operator provisioning requires a separate migration/owner URL; app cannot create accounts.
# Local synthetic fixtures only. Do not reuse these credentials in production.
EDUCATIONOS_ENVIRONMENT=development
EDUCATIONOS_DATABASE_URL=postgresql+psycopg://educationos_app:educationos-app-local-only@localhost:5432/educationos
EDUCATIONOS_REDIS_URL=redis://localhost:6379/0
EDUCATIONOS_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
EDUCATIONOS_RATE_LIMIT_PER_MINUTE=60
EDUCATIONOS_EVIDENCE_RETENTION_DAYS=30
# Optional explicit curriculum path; default bundled reviewed curriculum works from a wheel.
# EDUCATIONOS_CURRICULUM_PATH=../shared/curriculum/missions.v1.json
# Opt-in coarse spans only. Set approved collector /v1/traces URL; never log learner input.
# EDUCATIONOS_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# Test-only, disposable DB URLs. Integration tests may upgrade/downgrade these schemas.
# EDUCATIONOS_TEST_DATABASE_URL=postgresql+psycopg://educationos:educationos-local-only@localhost:5432/educationos_test
# EDUCATIONOS_TEST_APP_DATABASE_URL=postgresql+psycopg://educationos_app:educationos-app-local-only@localhost:5432/educationos_test
# EDUCATIONOS_TEST_WORKER_DATABASE_URL=postgresql+psycopg://educationos_worker:educationos-worker-local-only@localhost:5432/educationos_test
