{
  "components": {
    "schemas": {
      "AgeBand": {
        "enum": [
          "5-6",
          "7-9",
          "10-12",
          "13-15",
          "16-17"
        ],
        "title": "AgeBand",
        "type": "string"
      },
      "Attempt": {
        "additionalProperties": false,
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "learnerId": {
            "format": "uuid",
            "title": "Learnerid",
            "type": "string"
          },
          "missionVersionId": {
            "format": "uuid",
            "title": "Missionversionid",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "complete"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "learnerId",
          "missionVersionId",
          "status",
          "createdAt"
        ],
        "title": "Attempt",
        "type": "object"
      },
      "CreateEvidence": {
        "additionalProperties": false,
        "properties": {
          "attemptId": {
            "format": "uuid",
            "title": "Attemptid",
            "type": "string"
          },
          "payload": {
            "discriminator": {
              "mapping": {
                "idea": "#/components/schemas/TextEvidence",
                "measurement": "#/components/schemas/MeasurementEvidence",
                "observation": "#/components/schemas/TextEvidence",
                "reflection": "#/components/schemas/TextEvidence"
              },
              "propertyName": "kind"
            },
            "oneOf": [
              {
                "$ref": "#/components/schemas/TextEvidence"
              },
              {
                "$ref": "#/components/schemas/MeasurementEvidence"
              }
            ],
            "title": "Payload"
          },
          "step": {
            "enum": [
              "notice",
              "contradiction",
              "imagine",
              "hypothesis",
              "experiment",
              "reflect",
              "transfer"
            ],
            "title": "Step",
            "type": "string"
          }
        },
        "required": [
          "attemptId",
          "step",
          "payload"
        ],
        "title": "CreateEvidence",
        "type": "object"
      },
      "DeleteResult": {
        "additionalProperties": false,
        "properties": {
          "deleted": {
            "const": true,
            "default": true,
